{
  "name": "open-ethics-standard-mcp",
  "version": "0.1.0",
  "description": "MCP tools for reviewing software projects against the Open Ethics Standard, locally or through a remote endpoint.",
  "license": "MIT",
  "type": "module",
  "bin": { "oes-mcp": "dist/server.js" },
  "files": ["dist", "README.md"],
  "repository": { "type": "git", "url": "https://github.com/ike5/open-ethics-standard.git", "directory": "packages/oes-mcp" },
  "publishConfig": { "access": "public", "provenance": true },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node ../../scripts/build-catalog.mjs && node src/build.mjs",
    "prepack": "npm run build",
    "start": "node dist/server.js",
    "dev:remote": "wrangler dev --config wrangler.jsonc",
    "deploy:remote": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "agents": "^0.20.0",
    "esbuild": "^0.25.0",
    "wrangler": "^4.0.0"
  }
}
